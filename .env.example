# Google Cloud Service Account JSON key path
GOOGLE_APPLICATION_CREDENTIALS=service_account.json

# Google AI Studio / Gemini API
GOOGLE_AI_STUDIO_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Sheets (optional overrides if not using service account discovery)
GOOGLE_SHEET_ID_1=sheet_id_1
GOOGLE_SHEET_ID_2=sheet_id_2
GOOGLE_SHEET_ID_3=sheet_id_3
GOOGLE_SHEET_ID_4=sheet_id_4
GOOGLE_SHEET_ID_5=sheet_id_5
GOOGLE_SHEET_ID_6=sheet_id_6
GOOGLE_SHEET_ID_7=sheet_id_7
GOOGLE_SHEET_ID_8=sheet_id_8
GOOGLE_SHEET_ID_9=sheet_id_9
GOOGLE_SHEET_ID_10=sheet_id_10

# App config
APP_TITLE=Hermes Stock Dashboard
APP_ICON=📦
